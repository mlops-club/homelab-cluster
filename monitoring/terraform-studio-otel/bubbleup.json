    "color": {
     "mode": "scheme",
     "scheme": "Blues",
     "scale": "exponential",
     "exponent": 0.5,
     "fill": "dark-blue"
    },
    "rowsFrame": {
     "layout": "auto"
    },
    "tooltip": {
     "mode": "single",
     "yHistogram": true
    },
    "legend": {
     "show": true
    },
    "exemplars": {
     "color": "orange"
    }
   }
