  {
   "id": 7,
   "type": "xychart",
   "title": "Every span: ${y:text} over time. Click a dot, then a link, for its trace",
   "datasource": {
    "type": "tempo",
    "uid": "grafanacloud-traces"
   },
   "description": "TraceQL search, one dot per span (up to 1000 traces, 100 spans each: on a busy range not every span is shown, so narrow the time range). Duration is shown in time units. The Tempo panel merges every query into one frame, so spans in the band cannot be coloured separately: use the counts and the table below for the band",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 24,
    "h": 14
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "grafanacloud-traces"
     },
     "queryType": "traceql",
     "tableType": "spans",
     "limit": 1000,
     "spss": 100,
     "query": "{${spans} && resource.deployment.environment.name=\"otel-poc\"} | {${where}} | {${and}} | select(${y}, span.ce.page, span.ce.catalog, span.user.id, span.http.route, span.ce.course.key)"
    }
   ],
   "transformations": [
    {
     "id": "convertFieldType",
     "options": {
      "conversions": [
       {
        "targetField": "ce.page.ready.duration_ms",
        "destinationType": "number"
       },
       {
        "targetField": "ce.stats.api.slowest_ms",
        "destinationType": "number"
       },
       {
        "targetField": "ce.page.dom_nodes",
        "destinationType": "number"
       },
       {
        "targetField": "lcp.value",
        "destinationType": "number"
       },
