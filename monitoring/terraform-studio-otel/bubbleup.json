  {
   "id": 6,
   "type": "table",
   "title": "What the band has in common: attribute values by share of their spans in the band",
   "datasource": {
    "type": "tempo",
    "uid": "grafanacloud-traces"
   },
   "description": "TraceQL compare(): for each attribute value (top 10 per attribute), spans in the band and outside it. Share = in band / (in band + outside). Per-span IDs are hidden",
   "gridPos": {
    "x": 0,
    "y": 38,
    "w": 24,
    "h": 16
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "tempo",
      "uid": "grafanacloud-traces"
     },
     "queryType": "traceql",
     "metricsQueryType": "instant",
     "query": "{${spans} && resource.deployment.environment.name=\"otel-poc\"} | {${where}} | {${and}} | compare({${y} >= ${lo} && ${y} <= ${hi}}, 10)"
    }
   ],
   "transformations": [
    {
     "id": "seriesToRows",
     "options": {}
    },
    {
     "id": "extractFields",
     "options": {
      "source": "Metric",
      "format": "regexp",
      "regExp": "/\\{__meta_type=\"(?<type>[^\"]+)\", (?<item>.*)\\}/",
      "replace": false
     }
    },
    {
     "id": "filterByValue",
     "options": {
      "type": "exclude",
      "match": "any",
      "filters": [
       {
        "fieldName": "type",
        "config": {
         "id": "regex",
         "options": {
          "value": ".*_total"
         }
        }
       },
       {
        "fieldName": "item",
        "config": {
         "id": "regex",
         "options": {
          "value": "([^=]+=[-0-9.e+]+|.*sha256.*|.*(navigation_id|navigation_start_time|client\\.port|page_view\\.id|session\\.id|\\.delta|_time\\b|_time=|deployment\\.id|pipeline\\.run\\.id|SampleRate|instrumentation:|ce\\.page\\.stem).*)"
         }
        }
       }
      ]
     }
    },
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "type",
      "rowField": "item",
      "valueField": "Value",
      "emptyValue": "zero"
     }
    },
    {
     "id": "filterByValue",
     "options": {
      "type": "include",
      "match": "any",
      "filters": [
       {
        "fieldName": "selection",
        "config": {
         "id": "greaterOrEqual",
         "options": {
          "value": 3
         }
        }
       }
      ]
     }
    },
    {
     "id": "calculateField",
     "options": {
      "mode": "reduceRow",
      "alias": "all",
      "reduce": {
       "reducer": "sum",
       "include": [
        "baseline",
        "selection"
       ]
      }
     }
    },
    {
     "id": "calculateField",
