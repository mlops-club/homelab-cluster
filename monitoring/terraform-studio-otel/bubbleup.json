    "label": "Spans",
    "type": "custom",
    "query": "Backend requests : resource.service.name=\"golden-dataset-studio\" && kind=server,Page views (browser) : resource.service.name=\"golden-dataset-studio-web\" && name=\"page_view\",API calls (browser) : resource.service.name=\"golden-dataset-studio-web\" && kind=client,LCP reports (browser) : resource.service.name=\"golden-dataset-studio-web\" && name=\"LCP\"",
    "options": [
     {
      "text": "Backend requests",
      "value": "resource.service.name=\"golden-dataset-studio\" && kind=server",
      "selected": true
     },
     {
      "text": "Page views (browser)",
